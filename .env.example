# Copy to .env and adjust: cp .env.example .env
#
# Or let the stack do it: scripts/generate-secrets.sh fills every blank value
# below with a random one and tells you which it generated.
#
# `.env` is gitignored and is the ONLY place credentials live. Compose fails the
# start on a blank value (`${VAR:?…}`) rather than falling back to a known string.
# Keep `.env` in your backups: restoring a data volume without it brings up a
# database whose password nothing knows.

# Password bitcoind uses to talk to the Tor control port (private mode only).
# Rotate by editing it and restarting the private mode stack.
TOR_CONTROL_PASSWORD=

# Password for the explorer's own database user.
# Rotate with: scripts/rotate-db-password.sh app
MYSQL_PASSWORD=

# Password for the database superuser. Used for maintenance only.
# Rotate with: scripts/rotate-db-password.sh root
MYSQL_ROOT_PASSWORD=

# Uncomment to always start in private mode (Tor) with a plain `docker compose up -d`
#COMPOSE_FILE=docker-compose.yml:docker-compose.private.yml
