# Copy to .env and adjust: cp .env.example .env

# Password bitcoind uses to talk to the Tor control port (private mode only).
# Pick any random string, e.g. the output of: openssl rand -hex 32
TOR_CONTROL_PASSWORD=

# Uncomment to always start in private mode (Tor) with a plain `docker compose up -d`
#COMPOSE_FILE=docker-compose.yml:docker-compose.private.yml
